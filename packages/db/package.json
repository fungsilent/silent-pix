{
    "name": "@silent-pix/db",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "imports": {
        "#/*": {
            "development": "./src/*.ts",
            "types": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "tsx ./src/script/migrate.ts",
        "db:studio": "drizzle-kit studio",
        "db:reset": "tsx ./src/script/reset.ts",
        "db:seed": "tsx ./src/script/seed.ts"
    },
    "dependencies": {
        "@libsql/client": "^0.17.4",
        "@silent-pix/env": "workspace:*",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "uuid": "^14.0.1"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "drizzle-kit": "^0.31.10",
        "tsx": "^4.23.1"
    }
}
