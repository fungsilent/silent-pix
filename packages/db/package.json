        "typecheck": "tsc -p tsconfig.json --noEmit",
        "db:generate": "drizzle-kit generate"
    },
    "dependencies": {
        "better-sqlite3": "^13.0.2",
        "drizzle-orm": "^0.45.2"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^9.6.0",
        "drizzle-kit": "^0.31.10"
    }
}
