        "tasks_id_uuid_check": {
          "name": "tasks_id_uuid_check",
          "value": "\n    length(\"tasks\".\"id\") = 36\n    AND substr(\"tasks\".\"id\", 9, 1) = '-'\n    AND substr(\"tasks\".\"id\", 14, 1) = '-'\n    AND substr(\"tasks\".\"id\", 19, 1) = '-'\n    AND substr(\"tasks\".\"id\", 24, 1) = '-'\n    AND lower(\"tasks\".\"id\") NOT GLOB '*[^0-9a-f-]*'\n"
