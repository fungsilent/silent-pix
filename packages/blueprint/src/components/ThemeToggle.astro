---
/*
 * 取代 Starlight 的主題下拉選單：跟 App Header 一樣的 28px 圖示鈕，深色時顯示太陽、淺色時顯示月亮（點了切到該主題）。
 * 沿用 Starlight 的 localStorage `starlight-theme`，載入時由 Starlight 的主題腳本套用。
 */
---
<button type="button" data-ds-theme-toggle class="ds-theme-toggle" title="Toggle theme">
    <svg class="ds-theme-sun" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
    <svg class="ds-theme-moon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/></svg>
</button>

<script>
    document.querySelector('[data-ds-theme-toggle]')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light'
        document.documentElement.dataset.theme = next
        try {
            localStorage.setItem('starlight-theme', next)
        } catch {
            /* 無法存取 localStorage 時只切換這一頁 */
        }
    })
</script>

<style>
    .ds-theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.75rem;
        height: 1.75rem;
        padding: 0;
        border: 1px solid transparent;
        border-radius: 0.375rem;
        background: transparent;
        color: var(--sp-fg-muted);
    }

    .ds-theme-toggle:hover {
        background: var(--sp-hover);
        color: var(--sp-fg);
    }

    .ds-theme-moon,
    :global(:root[data-theme='light']) .ds-theme-sun {
        display: none;
    }

    :global(:root[data-theme='light']) .ds-theme-moon {
        display: block;
    }
</style>
