{
    "name": "@silent-pix/shared",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "main": "./dist/index.js",
    "imports": {
        "#shared/*": {
            "development": "./src/*.ts",
            "types": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "zod": "^4.4.3"
    }
}
