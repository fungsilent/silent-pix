{
    "name": "@silent-pix/server",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "./api": {
            "types": "./dist/app.d.ts",
            "default": "./dist/app.js"
        }
    },
    "imports": {
        "#/*": {
            "development": "./src/*.ts",
            "types": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "scripts": {
        "dev": "tsx watch --conditions=development src/index.ts",
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "image:gc": "tsx --conditions=development ./src/script/image-garbage-collection.ts",
        "image:gc:offline": "tsx --conditions=development ./src/script/image-garbage-collection-offline.ts"
    },
    "dependencies": {
        "@elysiajs/node": "^1.4.5",
        "@silent-pix/db": "workspace:*",
        "@silent-pix/env": "workspace:*",
        "@silent-pix/event": "workspace:*",
        "@silent-pix/shared": "workspace:*",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.4",
        "elysia": "^1.4.30",
        "image-size": "^2.0.4",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
