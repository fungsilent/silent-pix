{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "paths": {
            "@silent-pix/shared": ["./packages/shared/src/index.ts"],
            "@silent-pix/event/client": ["./packages/event/src/client.ts"],
            "@silent-pix/event/server": ["./packages/event/src/server.ts"],
            "@silent-pix/db": ["./packages/db/src/index.ts"]
        },
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}
