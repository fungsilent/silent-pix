{
  "name": "silent-pix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@silent-pix/server --filter=@silent-pix/web",
    "dev:web": "pnpm --filter @silent-pix/web dev",
    "dev:server": "pnpm --filter @silent-pix/server dev",
    "dev:desktop": "pnpm --filter @silent-pix/desktop dev",

    "build": "turbo run build",
    "typecheck": "turbo run typecheck",

    "lint": "eslint .",
    "lint:fix": "eslint . --fix",

    "check": "pnpm typecheck && pnpm lint",
    "clean": "git clean -fdX"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "globals": "latest",
    "turbo": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "@stylistic/eslint-plugin": "latest"
  }
}
