{
  "name": "silent-pix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.16.1",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@silent-pix/server --filter=@silent-pix/web",
    "dev:web": "pnpm --filter @silent-pix/web dev",
    "dev:server": "pnpm --filter @silent-pix/server dev",
    "dev:desktop": "pnpm --filter @silent-pix/desktop dev",
    "build:web": "turbo run build --filter=@silent-pix/web",
    "build:desktop": "pnpm --filter @silent-pix/desktop build:desktop",
    "deploy:start": "bash deploy/script/start.sh",
    "deploy:stop": "bash deploy/script/stop.sh",
    "deploy:down": "bash deploy/script/down.sh",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm typecheck && pnpm lint",
    "clean": "git clean -fdX",
    "db:generate": "pnpm --filter @silent-pix/db db:generate",
    "db:migrate": "pnpm --filter @silent-pix/db db:migrate",
    "db:studio": "pnpm --filter @silent-pix/db db:studio",
    "image:gc": "pnpm --filter @silent-pix/server image:gc",
    "image:gc:offline": "pnpm --filter @silent-pix/server image:gc:offline",
    "db:seed": "pnpm --filter @silent-pix/db db:seed",
    "db:reset": "pnpm --filter @silent-pix/db db:reset"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "globals": "^17.13.0",
    "turbo": "^2.11.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
