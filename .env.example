ENV=development

# backend and frontend host / port
SERVER_HOST=127.0.0.1
SERVER_PORT=3002
WEB_HOST=127.0.0.1
WEB_PORT=3001
CADDY_PORT=3000

# Server paths
APP_DATA_DIR=./.data
DATABASE_PATH=./.data/silent-pix.sqlite
APP_STORAGE_DIR=./.data/storage

# Deployment
# comfyui: start GPU container.
COMPOSE_PROFILES=

# ComfyUI
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_OUTPUT_DIR=/mnt/c/path/to/ComfyUI/output
COMFYUI_REFERENCE_DIR=\\wsl.localhost\Ubuntu\path\to\silent-pix\.data\storage
